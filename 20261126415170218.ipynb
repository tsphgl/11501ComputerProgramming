###for
x = 0

for i in range(1,11):
    x += i


###遞迴
def sum_to_n(n: int) -> int:
    if n <= 1:
        return n
    return n + sum_to_n(n - 1)


result = sum_to_n(10)
print(result)  



###reduce
from functools import reduce

result = reduce(lambda acc, x: acc + x, range(1, 11))
print(result)  
